---
import { langFromUrl } from '../i18n/locales';
import { ui } from '../i18n/ui';
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { widthsFor, IMAGE_QUALITY } from './image-widths';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  size?: 'text' | 'wide' | 'bleed' | 'margin';
  eager?: boolean;
  frame?: boolean;
  /** Link to a full-size copy that opens in the lightbox. */
  zoom?: boolean;
}
const { src, alt, caption, size = 'wide', eager = false, frame = true, zoom = true } = Astro.props;
const t = ui[langFromUrl(Astro.url)];
const full = zoom ? await getImage({ src, width: Math.min(2400, src.width), format: 'webp', quality: IMAGE_QUALITY }) : undefined;
const col = { text: 'col-text', wide: 'col-wide', bleed: 'col-full', margin: 'col-margin' }[size];
const sizes = {
  text: '(min-width: 900px) 56vw, 100vw',
  wide: '(min-width: 900px) 80vw, 100vw',
  bleed: '100vw',
  margin: '(min-width: 900px) 22vw, 100vw',
}[size];
---
<figure class:list={['figure', col, { 'figure--frame': frame }]}>
  {full ? (
    <a class="zoom" href={full.src} data-alt={alt} data-caption={caption}>
      <Picture src={src} alt={alt} formats={['avif', 'webp']} widths={widthsFor(src)} quality={IMAGE_QUALITY} sizes={sizes} loading={eager ? 'eager' : 'lazy'} decoding="async" />
      <span class="visually-hidden">{t.lightbox.opens}</span>
    </a>
  ) : (
    <Picture src={src} alt={alt} formats={['avif', 'webp']} widths={widthsFor(src)} quality={IMAGE_QUALITY} sizes={sizes} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  )}
  {caption && <figcaption class="meta">{caption}</figcaption>}
</figure>

<style>
  .figure { margin: var(--space-3) 0; }
  .figure :global(img) { width: 100%; height: auto; }
  .figure--frame :global(img) {
    border: 1px solid var(--rule);
    background: #fff;
  }
  figcaption { margin-top: var(--space-2); max-width: 60ch; }
</style>
