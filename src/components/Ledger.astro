---
/** Numbered two-column ledger: what was wrong → what changed. */
interface Props {
  rows: { issue: string; response: string }[];
  headers?: [string, string];
  caption: string;
}
const { rows, headers = ['Issue', 'What changed'], caption } = Astro.props;
---
<div class="ledger col-wide">
  <table>
    <caption class="meta">{caption}</caption>
    <thead>
      <tr><th scope="col"><span class="visually-hidden">Number</span></th><th scope="col">{headers[0]}</th><th scope="col">{headers[1]}</th></tr>
    </thead>
    <tbody>
      {rows.map((row, i) => (
        <tr>
          <td class="ledger__n">{String(i + 1).padStart(2, '0')}</td>
          <th scope="row">{row.issue}</th>
          <td>{row.response}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .ledger { margin-block: var(--space-3); }
  table { width: 100%; border-collapse: collapse; }
  caption { text-align: left; padding-bottom: var(--space-2); }
  th, td {
    text-align: left;
    vertical-align: top;
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    border-top: 1px solid var(--rule);
  }
  thead th {
    font-family: var(--sans);
    font-size: var(--step--1);
    font-weight: 600;
    border-top: 1px solid var(--ink);
    padding-block: var(--space-2);
  }
  tbody th {
    font-family: var(--serif);
    font-weight: 500;
    font-size: var(--step-1);
    line-height: 1.25;
    width: 34%;
  }
  .ledger__n { font-family: var(--sans); font-size: var(--step--2); color: var(--ink-muted); width: 3ch; padding-top: 1.4em; }
  @media (max-width: 720px) {
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    tr { display: grid; grid-template-columns: 3ch 1fr; column-gap: var(--space-2); border-top: 1px solid var(--rule); padding-block: var(--space-3); }
    th, td, tbody th { border: 0; padding: 0; width: auto; }
    .ledger__n { grid-row: span 2; padding-top: 0.4em; }
    tbody td:last-child { margin-top: var(--space-2); }
  }
</style>
