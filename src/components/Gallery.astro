---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}
interface Props {
  id: string;
  label: string;
  items: Item[];
}
const { id, label, items } = Astro.props;
const widthsFor = (src: ImageMetadata, list: number[]) => {
  const w = list.filter((n) => n <= src.width);
  return w.length ? w : [src.width];
};
---
<div class="gallery col-wide" data-gallery>
  <p class="meta gallery__label" id={`${id}-label`}>{label}. Select an image to enlarge it.</p>
  <ul class="gallery__grid" aria-labelledby={`${id}-label`}>
    {items.map((item, i) => (
      <li>
        <button type="button" class="gallery-thumb" data-index={i} aria-haspopup="dialog">
          <Picture src={item.src} alt="" formats={['avif', 'webp']} widths={widthsFor(item.src, [320, 640])} sizes="(min-width: 900px) 20vw, 45vw" loading="lazy" decoding="async" />
          <span class="gallery-thumb__caption">{item.caption ?? item.alt}</span>
        </button>
      </li>
    ))}
  </ul>
  <dialog class="gallery-dialog" aria-label={label}>
    <div class="gallery-dialog__bar">
      <p class="meta" aria-live="polite"><span data-count>1</span> of {items.length}</p>
      <div class="gallery-dialog__controls">
        <button type="button" data-prev class="label">← Previous</button>
        <button type="button" data-next class="label">Next →</button>
        <button type="button" data-close class="label">Close</button>
      </div>
    </div>
    {items.map((item, i) => (
      <figure class="gallery-dialog__item" data-item={i} hidden>
        <Picture src={item.src} alt={item.alt} formats={['avif', 'webp']} widths={widthsFor(item.src, [800, 1200, 1800])} sizes="90vw" loading="lazy" decoding="async" />
        <figcaption class="meta">{item.caption ?? item.alt}</figcaption>
      </figure>
    ))}
  </dialog>
</div>

<script>
  import { initGalleries } from '../scripts/gallery';
  initGalleries();
</script>

<style>
  .gallery { margin: var(--space-3) 0; }
  .gallery__label { margin-bottom: var(--space-2); }
  .gallery__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(160px, 40%), 1fr));
    gap: var(--space-4) var(--space-3);
  }
  .gallery-thumb {
    all: unset;
    box-sizing: border-box;
    cursor: zoom-in;
    display: block;
    width: 100%;
  }
  .gallery-thumb :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--rule);
    background: #fff;
    transition: border-color 150ms ease;
  }
  .gallery-thumb:hover :global(img) { border-color: var(--ink); }
  .gallery-thumb:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .gallery-thumb__caption {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--sans);
    font-size: var(--step--2);
    color: var(--ink-muted);
    line-height: 1.45;
  }
  .gallery-dialog {
    width: min(1200px, 92vw);
    max-height: 92vh;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    padding: var(--space-3);
  }
  .gallery-dialog::backdrop { background: rgb(20 19 15 / 0.82); }
  .gallery-dialog__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .gallery-dialog__controls { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .gallery-dialog__controls button {
    background: none;
    border: 1px solid var(--rule);
    color: var(--ink);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
  }
  .gallery-dialog__controls button:hover { border-color: var(--ink); }
  .gallery-dialog__item :global(img) {
    max-height: 72vh;
    width: auto;
    max-width: 100%;
    margin-inline: auto;
    border: 1px solid var(--rule);
    background: #fff;
  }
  .gallery-dialog__item figcaption { margin-top: var(--space-2); text-align: center; }
</style>
