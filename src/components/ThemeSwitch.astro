---
/**
 * Light/dark switch, built like the language switcher: the current theme is the solid chip.
 * The site is dark by default, whatever the system setting; a visitor's choice is kept in
 * localStorage and applied before first paint (see Base.astro). Needs JavaScript, so it
 * stays hidden without it.
 */
import type { Locale } from '../i18n/locales';
import { ui } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = ui[lang].theme;
---
<div class="theme-switch" role="group" aria-label={t.label}>
  <button type="button" data-theme-choice="light" aria-pressed="false">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.2" /><path class="rays" d="M12 2.8v2M12 19.2v2M2.8 12h2M19.2 12h2M5.5 5.5l1.4 1.4M17.1 17.1l1.4 1.4M5.5 18.5l1.4-1.4M17.1 6.9l1.4-1.4" /></svg>
    <span class="theme-switch__text">{t.light}</span>
  </button>
  <button type="button" data-theme-choice="dark" aria-pressed="false">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.4 14.6A8.5 8.5 0 0 1 9.4 3.6a8.5 8.5 0 1 0 11 11z" /></svg>
    <span class="theme-switch__text">{t.dark}</span>
  </button>
</div>

<script>
  const root = document.documentElement;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')];
  const current = () => (root.dataset.theme === 'light' ? 'light' : 'dark');
  const sync = () => buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeChoice === current())));
  sync();
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const next = b.dataset.themeChoice!;
      if (next === current()) return;
      // Swap the whole palette in one frame, rather than letting a few properties ease.
      root.classList.add('theme-switching');
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      sync();
      requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('theme-switching')));
    }),
  );
</script>

<style>
  .theme-switch { display: none; padding: 3px; gap: 2px; border: 1px solid var(--rule); border-radius: 999px; }
  :global(.js) .theme-switch { display: inline-flex; }
  .theme-switch button {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 24px; /* WCAG 2.5.8 target size */
    font-family: var(--sans);
    font-size: var(--switcher-size, var(--step--2));
    font-weight: 600;
    padding: 0.3em 0.8em 0.3em 0.65em;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
    transition: color var(--t-quick) ease, background-color var(--t-quick) ease;
  }
  .theme-switch button:hover { color: var(--ink); }
  .theme-switch button[aria-pressed='true'] { background: var(--selected-bg); color: var(--selected-fg); cursor: default; }
  .theme-switch svg { width: 1.15em; height: 1.15em; fill: currentColor; }
  .theme-switch .rays { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  /* Below 1200px the words stay for screen readers; sighted readers get the icons. */
  @media (max-width: 1199px) {
    .theme-switch { padding: 2px; }
    .theme-switch button { padding: 0.3em 0.4em; }
    .theme-switch__text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
</style>
