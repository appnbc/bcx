---
import { href, type Locale } from '../i18n/locales';
import { ui } from '../i18n/ui';
import { localized, titleLangAttr } from '../data/localized';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Locale;
}
const { project, lang } = Astro.props;
const p = localized(project, lang);
const t = ui[lang];
---
<header class="case-band">
  <div class="grid case-band__inner">
    <p class="col-wide case-band__kicker">
      <a href={href(lang, "/archive/")}>{t.nav.index}</a>
      <span aria-hidden="true">/</span>
      {p.disciplines.map((d) => t.disciplines[d]).join(', ')}
    </p>
    <h1 class="col-wide case-band__title" lang={titleLangAttr(p, lang)}>{p.title}</h1>
    <p class="col-text case-band__summary">{p.summary}</p>
    <dl class="col-margin case-band__facts">
      <div><dt>{t.facts.role}</dt><dd>{p.roleLang ? <span lang={p.roleLang}>{p.role}</span> : p.role}</dd></div>
      <div>
        <dt>{t.facts.where}</dt>
        <dd>{p.org}{p.context && <>, {p.context}</>}</dd>
      </div>
      <div>
        <dt>{t.facts.when}</dt>
        <dd>{p.years}{p.yearsNote && <span class="case-band__note" lang={p.yearsNoteLang}>{p.yearsNote}</span>}</dd>
      </div>
      {p.team && p.team.length > 0 && (
        <div>
          <dt>{t.facts.team}</dt>
          <dd><ul>{p.team.map((m) => <li>{m.name}, {/^[A-Z][a-z]/.test(m.role) ? m.role.charAt(0).toLowerCase() + m.role.slice(1) : m.role}</li>)}</ul></dd>
        </div>
      )}
      {p.liveUrl && (
        <div>
          <dt>{t.facts.liveSite}</dt>
          <dd><ul>{p.liveUrl.map((u) => <li><a href={u} rel="noopener">{u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></li>)}</ul></dd>
        </div>
      )}
      {p.notes && p.notes.length > 0 && (
        <div>
          <dt>{t.facts.note}</dt>
          <dd>{p.notes.map((n) => <p>{n}</p>)}</dd>
        </div>
      )}
    </dl>
  </div>
</header>

<style>
  /* Same header for every case study: paper, a large ink title, the facts beside it. */
  .case-band { padding-block: var(--space-6) var(--space-5); border-bottom: 2px solid var(--ink); }
  .case-band__inner { row-gap: var(--space-3); }
  .case-band__kicker { font-family: var(--sans); font-size: var(--step--1); font-weight: 600; color: var(--ink-muted); display: flex; gap: var(--space-2); flex-wrap: wrap; margin: 0; }
  /* The way back to the index: an arrow in the shared pink that steps back on hover or focus. */
  .case-band__kicker a { color: inherit; display: inline-flex; align-items: center; min-height: 24px; }
  .case-band__kicker a::before { content: '←' / ''; margin-right: 0.35em; color: var(--pink-ink); transition: translate var(--t-quick) var(--ease-out); }
  .case-band__kicker a:hover::before, .case-band__kicker a:focus-visible::before { translate: -3px 0; }
  .case-band__title {
    font-size: clamp(2.6rem, 1.4rem + 5vw, 6.5rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    max-width: 14ch;
    margin-bottom: var(--space-4);
  }
  .case-band__summary { font-size: var(--step-1); line-height: 1.4; }
  .case-band__facts {
    margin: 0;
    font-family: var(--sans);
    font-size: var(--step--2);
    line-height: 1.5;
    display: grid;
    gap: var(--space-3);
    align-self: start;
    padding: var(--space-4);
    border: 1px solid var(--rule);
    background: var(--paper-sunk);
  }
  .case-band__facts a { color: var(--ink); }
  @media (min-width: 900px) {
    .case-band__summary { grid-row: 3; }
    .case-band__facts { grid-row: 3 / span 2; }
  }
  .case-band__facts dt { font-weight: 600; color: var(--ink); }
  .case-band__facts dd { margin: 0; color: var(--ink-muted); }
  .case-band__facts ul { list-style: none; padding: 0; margin: 0; }
  .case-band__facts p { margin: 0 0 0.4em; }
  .case-band__note { display: block; font-style: italic; }
</style>
