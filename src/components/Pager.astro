---
import { href, type Locale } from '../i18n/locales';
import { ui } from '../i18n/ui';
import { localized, titleLangAttr } from '../data/localized';
import { getCollection } from 'astro:content';
import { inInventoryOrder } from '../data/projects-check';

interface Props {
  id: string;
  lang: Locale;
}
const { id, lang } = Astro.props;
const t = ui[lang];
const pages = inInventoryOrder(await getCollection('projects', (e) => e.data.form === 'page'));
const i = pages.findIndex((p) => p.id === id);
const prev = pages[(i - 1 + pages.length) % pages.length];
const next = pages[(i + 1) % pages.length];
---
<nav class="pager wrap" aria-label={t.pager.label}>
  <a href={href(lang, `/work/${prev.id}/`)} rel="prev"><span class="meta">{t.pager.previous}</span><span class="pager__title" lang={titleLangAttr(localized(prev, lang), lang)}>{localized(prev, lang).title}</span></a>
  <a href={href(lang, "/archive/")} class="pager__index"><span class="meta">{t.pager.all}</span><span class="pager__title">{t.nav.index}</span></a>
  <a href={href(lang, `/work/${next.id}/`)} rel="next"><span class="meta">{t.pager.next}</span><span class="pager__title" lang={titleLangAttr(localized(next, lang), lang)}>{localized(next, lang).title}</span></a>
</nav>

<style>
  .pager {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }
  @media (min-width: 700px) {
    .pager { grid-template-columns: 1fr auto 1fr; }
    .pager a[rel='next'] { text-align: right; }
  }
  .pager a {
    display: block;
    text-decoration: none;
    border-top: 1px solid var(--ink);
    padding-top: var(--space-3);
  }
  .pager .meta { display: block; }
  .pager__title { font-size: var(--step-1); }
  .pager a:hover .pager__title { text-decoration: underline; text-decoration-color: var(--highlight); text-decoration-thickness: 4px; text-decoration-thickness: 2px; }
</style>
