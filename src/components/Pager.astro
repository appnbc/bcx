---
import { withBase } from '../data/url';
import { getCollection } from 'astro:content';
import { inInventoryOrder } from '../data/projects-check';

interface Props {
  id: string;
}
const { id } = Astro.props;
const pages = inInventoryOrder(await getCollection('projects', (e) => e.data.form === 'page'));
const i = pages.findIndex((p) => p.id === id);
const prev = pages[(i - 1 + pages.length) % pages.length];
const next = pages[(i + 1) % pages.length];
---
<nav class="pager wrap" aria-label="More case studies">
  <a href={withBase(`/work/${prev.id}/`)} rel="prev"><span class="meta">Previous</span><span class="pager__title">{prev.data.title}</span></a>
  <a href={withBase("/archive/")} class="pager__index"><span class="meta">All projects</span><span class="pager__title">Index</span></a>
  <a href={withBase(`/work/${next.id}/`)} rel="next"><span class="meta">Next</span><span class="pager__title">{next.data.title}</span></a>
</nav>

<style>
  .pager {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }
  @media (min-width: 700px) {
    .pager { grid-template-columns: 1fr auto 1fr; }
    .pager a[rel='next'] { text-align: right; }
  }
  .pager a {
    display: block;
    text-decoration: none;
    border-top: 1px solid var(--ink);
    padding-top: var(--space-3);
  }
  .pager .meta { display: block; }
  .pager__title { font-size: var(--step-1); }
  .pager a:hover .pager__title { text-decoration: underline; text-decoration-color: var(--highlight); text-decoration-thickness: 4px; text-decoration-thickness: 2px; }
</style>
