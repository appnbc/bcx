---
/** A note in the margin, set off by the editor's bracket (.bracket in layout.css). */
interface Props {
  label?: string;
}
const { label } = Astro.props;
---
<aside class="col-margin margin-note bracket" aria-label={label ?? 'Note'}>
  {label && <p class="margin-note__label">{label}</p>}
  <div class="margin-note__body"><slot /></div>
</aside>

<style>
  .margin-note {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--ink-muted);
    padding-block: var(--space-1);
    align-self: start;
  }
  .margin-note__label {
    font-family: var(--sans);
    font-style: normal;
    font-weight: 600;
    font-size: var(--step--2);
    color: var(--ink);
    margin-bottom: var(--space-1);
  }
  .margin-note :global(p) { margin-bottom: 0.6em; }
  .margin-note :global(a) { color: var(--ink); }
</style>
