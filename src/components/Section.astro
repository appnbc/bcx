---
/**
 * A titled section on the editorial grid. Children place themselves with
 * layout classes (.col-text, .col-wide, …); a MarginNote placed right after a
 * .col-text block lands beside it on wide screens and after it on narrow ones.
 * Every section opens the same way: an ink rule, then the title.
 */
interface Props {
  id: string;
  title: string;
  kicker?: string;
}
const { id, title, kicker } = Astro.props;
---
<section class="section grid" id={id} aria-labelledby={`${id}-title`}>
  <header class="col-text section-head">
    {kicker && <p class="section-head__kicker">{kicker}</p>}
    <h2 id={`${id}-title`}>{title}</h2>
  </header>
  <slot />
</section>

<style>
  .section {
    row-gap: var(--space-4);
    padding-block: var(--space-7) 0;
  }
  .section-head { margin-bottom: var(--space-2); border-top: 2px solid var(--ink); padding-top: var(--space-3); }
  .section-head__kicker {
    font-family: var(--sans);
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--ink-muted);
    margin-bottom: var(--space-1);
  }
</style>
