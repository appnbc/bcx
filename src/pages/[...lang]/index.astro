---
import { getCollection } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { widthsFor, IMAGE_QUALITY } from '../../components/image-widths';
import Base from '../../layouts/Base.astro';
import EditView from '../../components/EditView.astro';
import Mixed from '../../components/Mixed.astro';
import HeroArt from '../../components/HeroArt.astro';
import { site } from '../../config';
import { img } from '../../data/images';
import { types } from '../../data/taxonomy';
import { href, langOf, getLangPaths } from '../../i18n/locales';
import { homeCopy } from '../../i18n/pages/home';
import { sunnyvaleCopy } from '../../i18n/pages/sunnyvale-cleanwater';
import { descubreCopy } from '../../i18n/pages/descubre';
import { alfredoCopy } from '../../i18n/pages/alfredo-voice-services';
import { ui } from '../../i18n/ui';
import { localized, titleLangAttr } from '../../data/localized';

export const getStaticPaths = getLangPaths;
const lang = langOf(Astro.params.lang);
const c = homeCopy[lang];
const t = ui[lang];

const all = await getCollection('projects');
const byId = (id: string) => all.find((e) => e.id === id)!;

const practice = all.filter((e) => e.data.featured === 'practice').sort((a, b) => b.data.sortYear - a.data.sortYear).map((e) => ({ id: e.id, p: localized(e, lang) }));
const counts = types.map((type) => {
  const n = all.filter((e) => e.data.type === type).length;
  return `${n} ${c.counts[type][n === 1 ? 0 : 1]}`;
});

const selected = [
  {
    id: 'sunnyvale-cleanwater',
    image: { src: img('sunnyvale-cleanwater', 'sunnyvalecleanwater_4.png') },
  },
  {
    id: 'ladwp-turf-replacement',
    image: { src: img('ladwp-turf-replacement', 'LA_WP_dept_7.png') },
    back: img('ladwp-turf-replacement', 'LA_WP_dept_6.png'),
  },
  { id: 'alfredo-voice-services' },
  {
    id: 'descubre',
    image: { src: img('descubre', 'VHL_3.png') },
  },
  { id: '526-lowcountry-corridor' },
  {
    id: 'the-burger-queen',
    image: { src: img('the-burger-queen', 'Alexa_Hotel_13.png') },
    back: img('the-burger-queen', 'Alexa_Hotel_12.png'),
  },
].map((s: { id: string; image?: { src: ImageMetadata }; back?: ImageMetadata }) => {
  const entry = byId(s.id);
  const p = localized(entry, lang);
  const d = entry.data.disciplines;
  const kinds = [d.includes('UX Design') && 'design', (d.includes('UX Writing') || d.includes('Content Strategy')) && 'writing'].filter(Boolean);
  return { ...s, p, focus: c.focus[s.id], alt: c.alts[s.id] ?? '', kinds: kinds.join(' ') };
});
const sv = sunnyvaleCopy[lang];
const ds = descubreCopy[lang];
const al = alfredoCopy[lang];
const samples = [
  {
    id: 'sunnyvale-cleanwater',
    section: 'microcopy',
    where: sv.microcopy.subtitleTitle,
    parts: [{ t: 'Meeting ' }, { del: 'Service and Environment Goals' }, { ins: 'service and environment goals' }, { t: ' ' }, { del: 'now' }, { ins: 'today' }, { t: ' and for ' }, { del: 'the' }, { ins: 'our' }, { t: ' future' }],
  },
  {
    id: 'descubre',
    section: 'digital',
    where: ds.digital.title,
    parts: [{ t: '“' }, { del: 'circle' }, { ins: 'select' }, { t: ' the word”' }],
  },
  {
    id: 'alfredo-voice-services',
    section: 'sms',
    where: al.sms.cancel,
    lang: 'es',
    parts: [{ del: 'STOP' }, { ins: 'NO' }],
  },
].map((x) => ({ ...x, p: localized(byId(x.id), lang) }));
const fulls = await Promise.all(selected.map(async (s) => (s.image ? (await getImage({ src: s.image.src, width: Math.min(2400, s.image.src.width), format: 'webp', quality: IMAGE_QUALITY })).src : undefined)));

---
<Base lang={lang} title={site.name} description={c.description} overlayHeader>
  <div class="hero-wash" aria-hidden="true"></div>
  <div class="wrap calm">
    <header class="grid intro">
      <h1 class="col-wide hero">
        {c.headline.map((seg) => ('m' in seg ? <mark>{seg.m}</mark> : seg.t))}
      </h1>
      <p class="col-text intro__sub">{c.sub}</p>
      <div class="intro__art"><HeroArt /></div>
      <aside class="col-margin note bracket">
        <p class="label-text">{c.currentlyLabel}</p>
        <p>{c.currently}</p>
      </aside>
    </header>

    <section id="work" class="block" aria-labelledby="selected-title">
      <div class="thread" aria-hidden="true"></div>
      <div class="block__head">
        <h2 id="selected-title">{c.selectedTitle}</h2>
        <div class="switch" data-switch role="group" aria-label={c.switch.label}>
          <button type="button" data-show="all" aria-pressed="true">{c.switch.all}</button>
          <button type="button" data-show="design" aria-pressed="false">{c.switch.design}</button>
          <button type="button" data-show="writing" aria-pressed="false">{c.switch.writing}</button>
        </div>
        <p class="visually-hidden" role="status" data-switch-status data-all={c.switch.statusAll} data-design={c.switch.statusDesign} data-writing={c.switch.statusWriting}></p>
      </div>
      {selected.map((s, i) => (
        <article class:list={['grid selected', { 'selected--flip': i % 2 === 1 }]} data-kinds={s.kinds}>
          <div class:list={['selected__visual mat', i % 2 === 0 ? 'mat--a' : 'mat--b']}>
            {s.image ? (
              <a class:list={['zoom mat__item', { mat__stack: s.back }]} href={fulls[i]} data-alt={s.alt} data-caption={s.p.title}>
                {s.back && <Picture class="mat__back" src={s.back} alt="" formats={['avif', 'webp']} widths={widthsFor(s.back)} quality={IMAGE_QUALITY} sizes="(min-width: 900px) 40vw, 80vw" loading="lazy" style={`--w: ${s.back.width}px`} />}
                <Picture class="mat__front" src={s.image.src} alt={s.alt} formats={['avif', 'webp']} widths={widthsFor(s.image.src)} quality={IMAGE_QUALITY} sizes="(min-width: 900px) 50vw, 100vw" loading={i === 0 ? 'eager' : 'lazy'} style={`--w: ${s.image.src.width}px`} />
                <span class="visually-hidden">{t.lightbox.opens}</span>
              </a>
            ) : s.id === 'alfredo-voice-services' ? (
              <div class="selected__type">
                <p class="label-text">{c.alfredoLabel}</p>
                <EditView lang="es" parts={[{ t: 'Son las diez ' }, { del: 'a.m.' }, { ins: 'de la mañana' }, { t: '.' }]} caption={c.alfredoCaption} />
              </div>
            ) : (
              <div class="selected__type">
                <p class="label-text">{c.lccLabel}</p>
                <ul class="selected__issues">{c.lccIssues.map((x) => <li>{x}</li>)}</ul>
              </div>
            )}
          </div>
          <div class="selected__text">
            <p class="label-text">{s.focus}</p>
            <h3><a href={href(lang, `/work/${s.id}/`)} lang={titleLangAttr(s.p, lang)}>{s.p.title}</a></h3>
            <p>{s.p.summary}</p>
            <p class="label-text">{s.p.org}, {s.p.years}</p>
            <p><a class="more" href={href(lang, `/work/${s.id}/`)}>{c.readCase}<span class="visually-hidden">: {s.p.title}</span></a></p>
          </div>
        </article>
      ))}
    </section>

    <section class="block" aria-labelledby="samples-title">
      <div class="block__head">
        <h2 id="samples-title">{c.samplesTitle}</h2>
      </div>
      <p class="block__lead">{c.samplesLead}</p>
      <ul class="three-up samples">
        {samples.map((x) => (
          <li class="sample">
            <p class="label-text"><span lang={titleLangAttr(x.p, lang)}>{x.p.title}</span>: {x.where}</p>
            <EditView size="small" verbatim lang={x.lang} parts={x.parts} />
            {x.id === 'sunnyvale-cleanwater' ? (
              <ul class="sample__why">{sv.microcopy.changes.map((ch) => <li><strong><Mixed text={ch.term} /></strong>{ch.rest}</li>)}</ul>
            ) : x.id === 'descubre' ? (
              <p>{c.samplesDescubreWhy}</p>
            ) : (
              <p><Mixed text={al.sms.stop} /></p>
            )}
            <p><a class="more" href={href(lang, `/work/${x.id}/#${x.section}`)}>{c.samplesLink}<span class="visually-hidden">: {x.p.title}</span></a></p>
          </li>
        ))}
      </ul>
    </section>

    <section class="block" aria-labelledby="practice-title">
      <div class="block__head">
        <h2 id="practice-title">{c.practiceTitle}</h2>
      </div>
      <p class="block__lead">{c.practiceLead}</p>
      <ul class="three-up practice">
        {practice.map((e) => (
          <li>
            <p class="label-text">{e.p.org}, {e.p.years}</p>
            <h3><a href={href(lang, `/archive/#${e.id}`)} lang={titleLangAttr(e.p, lang)}>{e.p.title}</a></h3>
            <p>{e.p.summary}</p>
            <p class="label-text">{e.p.roleLang ? <span lang={e.p.roleLang}>{e.p.role}</span> : e.p.role}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="block" aria-labelledby="index-title">
      <h2 id="index-title" class="visually-hidden">{c.everythingElse}</h2>
      <a class="all-link" href={href(lang, "/archive/")}>{c.seeAll.replace('{n}', String(all.length))}</a>
      <p class="label-text">{counts.join(', ')}</p>
    </section>

    <section class="block" aria-labelledby="about-title">
      <div class="block__head">
        <h2 id="about-title">{c.aboutTitle}</h2>
      </div>
      <div class="prose">
        <p>{c.aboutText}</p>
        <p><a class="more" href={href(lang, "/about/")}>{c.aboutLink}</a></p>
      </div>
    </section>
  </div>
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('[data-switch]');
  const status = document.querySelector<HTMLElement>('[data-switch-status]');
  const items = [...document.querySelectorAll<HTMLElement>('article.selected')];
  bar?.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('button[data-show]');
    if (!btn) return;
    const show = btn.dataset.show!;
    for (const b of bar.querySelectorAll('button')) b.setAttribute('aria-pressed', String(b === btn));
    let n = 0;
    items.forEach((item) => {
      const on = show === 'all' || (item.dataset.kinds ?? '').split(' ').includes(show);
      item.hidden = !on;
      if (on) n++;
    });
    items.filter((item) => !item.hidden).forEach((item, i) => item.classList.toggle('selected--flip', i % 2 === 1));
    const template = status?.dataset[show] ?? '{n}';
    if (status) status.textContent = template.replace('{n}', String(n));
  });
</script>

<style>
  /*
   * One signature (the teal highlighter), one rule for shapes
   * (square corners; pills only for controls), one label style, ink + paper.
   * The page's language tints the washes, the mats, and the fine lines.
   */
  .calm { --hl: var(--highlight); }

  /* The one label style. */
  .label-text {
    font-family: var(--sans);
    font-size: var(--step--1);
    font-weight: 600;
    font-style: normal;
    color: var(--ink-muted);
    margin: 0 0 var(--space-2);
  }

  /* Highlighter: the only mark. */
  mark {
    background: linear-gradient(var(--hl), var(--hl)) no-repeat 0 var(--mark-pos) / 100% var(--mark-band);
    color: var(--mark-fg);
    padding-inline: 0.04em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    animation: swipe 650ms cubic-bezier(0.6, 0, 0.3, 1) backwards;
  }
  mark:nth-of-type(1) { animation-delay: 300ms; }
  mark:nth-of-type(2) { animation-delay: 650ms; }
  mark:nth-of-type(3) { animation-delay: 1000ms; }
  @keyframes swipe { from { background-size: 0% var(--mark-band); } }
  @media (prefers-reduced-motion: reduce) { mark { animation: none; } }

  /* A still wash of the two brand colours behind the (transparent) header and the hero;
     it fades out before the work. */
  .hero-wash {
    position: absolute;
    inset: 0 0 auto;
    height: clamp(720px, 105vh, 1100px);
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(min(760px, 90vw) 620px at 80% 40%, var(--wash-a), transparent 70%),
      radial-gradient(min(820px, 110vw) 640px at 10% 16%, var(--wash-b), transparent 70%),
      radial-gradient(min(620px, 80vw) 420px at 40% 80%, var(--wash-c), transparent 70%);
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }
  .intro { padding-top: var(--space-7); row-gap: var(--space-5); --ink-muted: var(--ink-muted-on-wash); }
  .hero {
    font-size: clamp(2.25rem, 1.2rem + 4.2vw, 5.5rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 400;
    max-width: 17ch;
  }
  .intro__sub { font-size: var(--step-1); line-height: 1.4; color: var(--ink-muted); }
  .note { align-self: end; font-size: var(--step--1); color: var(--ink-muted); }
  .intro__art { max-width: 340px; width: 100%; justify-self: center; }
  @media (min-width: 900px) {
    .intro .hero { grid-column: 1 / 8; grid-row: 1; }
    .intro .intro__sub { grid-column: 1 / 7; grid-row: 2; }
    .intro .note { grid-column: 1 / 7; grid-row: 3; align-self: start; }
    .intro__art { grid-column: 8 / 13; grid-row: 1 / span 3; align-self: center; max-width: none; }
  }

  /* Pills are for controls only. */
  .switch { display: none; gap: 2px; padding: 3px; border-radius: 999px; border: 1px solid var(--rule); width: fit-content; }
  :global(.js) .switch { display: inline-flex; }
  .switch button {
    font-family: var(--sans);
    font-size: var(--step--1);
    font-weight: 600;
    border: 0;
    border-radius: 999px;
    padding: 0.4em 1.1em;
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
    transition: color var(--t-quick) ease, background-color var(--t-quick) ease;
  }
  .switch button:hover { color: var(--ink); }
  .switch button[aria-pressed='true'] { background: var(--selected-bg); color: var(--selected-fg); }

  /* Every section opens the same way: a full-width ink rule, then the title. */
  .block { margin-top: var(--space-7); }

  /* The signal thread: on wide screens a fine line comes out of the bottom of the illustration's
     interface (it starts behind it, so the window hides its top end), turns, runs back across
     the page, and lands on the work's opening rule at a teal node: from the copy being edited
     into the work itself. Still and decorative. */
  .thread { display: none; }
  @media (min-width: 900px) {
    #work { position: relative; }
    .thread {
      display: block;
      position: absolute;
      z-index: -1;
      left: 0;
      right: 0;
      bottom: 100%;
      height: 420px;
      pointer-events: none;
      --r: 14px;
      --bend: 44px;
      --thread: var(--rule-strong);
    }
    /* Down from the interface, then left. */
    .thread::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: var(--bend);
      left: var(--r);
      right: 20.5%;
      border: solid var(--thread);
      border-width: 0 1px 1px 0;
      border-bottom-right-radius: var(--r);
    }
    /* Then down to the rule, ending at the node. */
    .thread::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: var(--r);
      height: calc(var(--bend) + 1px);
      border: solid var(--thread);
      border-width: 1px 0 0 1px;
      border-top-left-radius: var(--r);
    }
    #work > .block__head { position: relative; }
    #work > .block__head::before {
      content: '';
      position: absolute;
      top: -5px;
      left: -4px;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--mark-point);
      box-shadow: 0 0 0 2px var(--paper);
    }
  }
  .block__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    border-top: 2px solid var(--ink);
    padding-top: var(--space-3);
  }
  .block h2 { font-size: var(--step-3); }
  .block__lead { max-width: 60ch; margin-top: var(--space-3); }

  .selected { padding-block: var(--space-6); row-gap: var(--space-4); align-items: center; border-bottom: 1px solid var(--rule); }
  .selected:last-of-type { border-bottom: 0; }
  /* Work sits on a tinted panel, never larger than the real file: small originals
     read as deliberate, and two-screen piles sit like papers on a desk. */
  .mat {
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    aspect-ratio: 4 / 3;
    padding: clamp(var(--space-4), 6%, var(--space-6));
    background: color-mix(in srgb, var(--mat-accent) var(--mat-dose), var(--paper));
    --ink-muted: var(--ink-muted-on-wash);
    transition: background-color var(--t-quick) ease, translate var(--t-quick) var(--ease-out);
  }
  /* Registration marks at two opposite corners, as on a proof sheet: a fine trim line
     just outside the panel. They draw in a little closer when the work is hovered or focused. */
  .selected__visual { position: relative; }
  .selected__visual::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--reg-gap));
    pointer-events: none;
    --reg-gap: 12px;
    --reg-len: 10px;
    --reg: linear-gradient(var(--rule-strong), var(--rule-strong));
    background:
      var(--reg) 0 0 / var(--reg-len) 1px no-repeat,
      var(--reg) 0 0 / 1px var(--reg-len) no-repeat,
      var(--reg) 100% 100% / var(--reg-len) 1px no-repeat,
      var(--reg) 100% 100% / 1px var(--reg-len) no-repeat;
    transition: inset var(--t-quick) var(--ease-out);
  }
  .selected:focus-within .selected__visual::before { inset: -8px; }
  @media (hover: hover) {
    .selected:hover .selected__visual::before { inset: -8px; }
  }
  .mat--a { --mat-accent: var(--accent-a); }
  .mat--b { --mat-accent: var(--accent-b); }
  /* A featured project answers the pointer, or the keyboard, as one piece:
     its panel lifts 2px and the language's light gathers in it. */
  .selected:focus-within .mat { --mat-dose: var(--mat-dose-hover); translate: 0 -2px; }
  @media (hover: hover) {
    .selected:hover .mat { --mat-dose: var(--mat-dose-hover); translate: 0 -2px; }
  }
  .mat__item {
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    width: 100%;
    height: 100%;
  }
  .mat :global(picture) { display: contents; }
  .mat :global(.mat__front), .mat :global(.mat__back) {
    grid-area: 1 / 1;
    width: auto;
    height: auto;
    max-width: min(100%, var(--w));
    max-height: 100%;
    object-fit: contain;
    background: #fff;
    box-shadow: 0 18px 36px -18px var(--mat-shadow), 0 2px 6px -2px var(--mat-shadow);
  }
  .mat__stack :global(.mat__front) { max-width: min(88%, var(--w)); max-height: 88%; rotate: 2deg; translate: 5% 6%; }
  .mat__stack :global(.mat__back) { max-width: min(88%, var(--w)); max-height: 88%; rotate: -3deg; translate: -5% -6%; }
  .selected__type { justify-self: stretch; }
  /* Text panels keep the 4:3 shape where they can, but grow when longer translations need room. */
  .mat:has(> .selected__type) { grid-template-rows: auto; }

  .samples { margin-top: var(--space-5); }
  .sample { background: var(--mat-b); --ink-muted: var(--ink-muted-on-wash); padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-3); }
  .sample :global(.edit-view) { margin: 0; }
  .sample p, .sample__why { margin: 0; font-size: var(--step--1); color: var(--ink-muted); }
  .sample__why { padding-left: 1.1em; }
  .sample p:last-child { margin-top: auto; padding-top: var(--space-2); font-size: var(--step-0); color: var(--ink); }
  .selected__type :global(.edit-view--large .edit-view__line) { font-size: var(--step-3); }
  .selected__issues { list-style: none; margin: var(--space-3) 0 0; padding: 0; font-size: var(--step-2); line-height: 1.25; }
  .selected__issues li { padding: var(--space-2) 0; border-top: 1px solid var(--rule); }
  .selected h3 { font-size: var(--step-3); font-weight: 400; letter-spacing: -0.02em; margin: 0 0 var(--space-3); }
  .selected h3 a, .practice h3 a { text-decoration: none; }
  .selected h3 a, .practice h3 a { text-decoration: underline 2px transparent; text-underline-offset: 0.16em; transition: text-decoration-color var(--t-quick) ease; }
  .selected h3 a:hover, .practice h3 a:hover { text-decoration-color: var(--accent-a-ink); }
  @media (min-width: 900px) {
    .selected .selected__visual { grid-column: 1 / 8; }
    .selected .selected__text { grid-column: 9 / 13; }
    .selected--flip .selected__visual { grid-column: 6 / 13; grid-row: 1; }
    .selected--flip .selected__text { grid-column: 1 / 5; grid-row: 1; }
  }

  /* Links that lead somewhere: an underline in the language's accent, flooded with teal on hover. */
  .more, .all-link {
    font-family: var(--sans);
    font-weight: 600;
    color: inherit;
    text-decoration: underline 2px var(--accent-a-ink);
    text-underline-offset: 0.25em;
    background: linear-gradient(var(--hl), var(--hl)) no-repeat 0 100% / 100% 0;
    padding-inline: 0.1em;
    transition: background-size var(--t-quick) var(--ease-out), color var(--t-quick) ease, text-decoration-color var(--t-quick) ease;
  }
  .more:hover, .all-link:hover, .more:focus-visible, .all-link:focus-visible { background-size: 100% 100%; color: var(--on-highlight); text-decoration-color: var(--on-highlight); }
  .all-link { display: inline-block; font-family: var(--serif); font-weight: 400; font-size: var(--step-4); letter-spacing: -0.02em; margin-bottom: var(--space-2); }

  .practice { list-style: none; padding: 0; margin: var(--space-5) 0 0; }
  .practice li { border-top: 1px solid var(--rule); padding-top: var(--space-3); transition: border-color var(--t-quick) ease; }
  .practice li:focus-within { border-top-color: var(--ink); }
  @media (hover: hover) { .practice li:hover { border-top-color: var(--ink); } }
  .practice h3 { font-size: var(--step-2); font-weight: 400; margin: 0 0 var(--space-2); }
  .practice p { font-size: var(--step--1); }

