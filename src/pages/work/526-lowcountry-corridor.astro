---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import CaseSections from '../../components/CaseSections.astro';
import Section from '../../components/Section.astro';
import MarginNote from '../../components/MarginNote.astro';
import Ledger from '../../components/Ledger.astro';
import Persona from '../../components/Persona.astro';
import Pager from '../../components/Pager.astro';

const project = (await getEntry('projects', '526-lowcountry-corridor'))!;

const issues = [
  {
    issue: 'Color contrast in the brand palette',
    response: 'The site’s green and blue are part of its branding, but they didn’t contrast enough for people with low vision or color blindness to tell elements apart. The color scheme was improved for contrast while keeping the brand.',
  },
  {
    issue: 'Keyboard navigation and a separate Spanish menu',
    response: 'Keyboard users struggled to move through the menus, and a separate menu for Spanish speakers added confusion. Keyboard navigation was streamlined and language access made consistent across both menus.',
  },
  {
    issue: 'Missing alt text and video scripts',
    response: 'Images without alt text shut out screen reader users, and videos without scripts shut out people who are hard of hearing. Images got alt text and videos got scripts.',
  },
  {
    issue: 'Language barrier',
    response: 'For non-English speakers like Daniel, translation has to be straightforward, without idioms or slang. Language access was made consistent across the site.',
  },
  {
    issue: 'Unlabeled arrow icons',
    response: 'Arrows mark navigation, external links and downloads. The recommendation: give each one descriptive alt text, so everyone knows what it does.',
  },
  {
    issue: 'Limited testing with diverse users',
    response: 'Testing hadn’t covered a wide range of users, including people with disabilities. That’s the next step.',
  },
];
---
<Base title={project.data.title} description={project.data.summary} current="work">
  <article class="wrap">
    <CaseHeader project={project} />
    <CaseSections>

    <Section id="role" title="Role">
      <div class="col-text prose">
        <p>
          I was the UX designer for the 526 Lowcountry Corridor website, I built it in the content management system, and I led its
          accessibility work. I worked with Alyssa, the community manager, and Amy, the project manager. The site shipped and is still
          live.
        </p>
        <p>
          The project’s audience includes people for whom English isn’t a first language, so accessibility here meant language access
          as well as access for people with disabilities.
        </p>
      </div>
    </Section>

    <Section id="persona" title="Persona">
      <div class="col-text">
        <Persona
          name="Daniel"
          age={35}
          status="Single"
          occupation="Trucker"
          location="Charleston, South Carolina"
          bio="A Spanish speaker who isn’t proficient in English. He needs project information in straightforward Spanish, and a site he can navigate without hunting for a separate menu."
        />
      </div>
    </Section>

    <Section id="issues" title="Accessibility issues and responses" kicker="Accessibility">
      <div class="col-text prose">
        <p>Six issues shaped the work. The first four were fixed on the site; the last two are recommendations for what comes next.</p>
      </div>
      <Ledger caption="Issues found and what happened" headers={['Issue', 'Response']} rows={issues} />
    </Section>

    <Section id="retrospective" title="Retrospective">
      <div class="col-text prose">
        <p>
          Fixing color contrast, keyboard navigation, the language menus, alt text and video scripts made the site easier to use for
          more people, especially those with visual or hearing impairments and Spanish speakers.
        </p>
        <p>
          The lesson I took from it: accessibility needs continued attention and testing with a genuinely diverse group of users,
          including people with disabilities.
        </p>
      </div>
    </Section>
    </CaseSections>
  </article>
  <Pager id={project.id} />
</Base>
