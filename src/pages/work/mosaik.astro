---
import { withBase } from '../../data/url';
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import CaseSections from '../../components/CaseSections.astro';
import Section from '../../components/Section.astro';
import MarginNote from '../../components/MarginNote.astro';
import Figure from '../../components/Figure.astro';
import Pager from '../../components/Pager.astro';
import { img } from '../../data/images';

const project = (await getEntry('projects', 'mosaik'))!;
---
<Base title={project.data.title} description={project.data.summary} current="work">
  <article class="wrap">
    <CaseHeader project={project} />
    <CaseSections>

    <Section id="carried-over" title="What carried over">
      <div class="col-text prose">
        <p>
          Mosaik is Vista Higher Learning’s German program, one of the curricula I worked on as developmental editor.
          The design decisions made for <a href={withBase("/work/descubre/")}>Descubre</a>, from the editorial style guide to the digital
          features, were applied to the German collection the following year.
        </p>
        <p>
          The shared guidelines were written for exactly this: colleagues covered French, German and Italian alongside my Spanish,
          with English as the common base, so one set of rules could serve every language.
        </p>
      </div>
      <MarginNote label="More detail">The reasoning behind these decisions is in the <a href={withBase("/work/descubre/")}>Descubre case study</a>.</MarginNote>
      <Figure src={img('mosaik', 'VHL_GermanCovers.png')} alt="Covers of Mosaik 1, 2 and 3: colorful photographs of European buildings and architecture." caption="The Mosaik series, ©2018." size="wide" frame={false} />
    </Section>
    </CaseSections>
  </article>
  <Pager id={project.id} />
</Base>
