---
import { getEntry } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import CaseSections from '../../components/CaseSections.astro';
import Section from '../../components/Section.astro';
import MarginNote from '../../components/MarginNote.astro';
import Persona from '../../components/Persona.astro';
import Pager from '../../components/Pager.astro';
import { img } from '../../data/images';

const project = (await getEntry('projects', 'the-burger-queen'))!;

// Alexa's side of the conversation, transcribed exactly from each prototype screen.
type Line = string | { text: string; lang: string; italic: true };
const screens: { file: string; step: string; lines: Line[][]; picture: string }[] = [
  { file: 'Alexa_Hotel_10.png', step: 'Greeting', lines: [['Welcome to Las Vegas!']], picture: 'the Welcome to Fabulous Las Vegas sign at night' },
  { file: 'Alexa_Hotel_11.png', step: 'Venues', lines: [['There are lots of restaurants in Las Vegas, including our very own The Burger Queen.'], ['What type of restaurant would you like to eat at today?']], picture: 'a burger and fries' },
  { file: 'Alexa_Hotel_12.png', step: 'Hours', lines: [['Our 5-star restaurant, The Burger Queen, is open from 8 a.m. to 10 p.m. Monday to Saturday and from 10 a.m. to 12 a.m. on Sundays.']], picture: 'a burger and fries' },
  { file: 'Alexa_Hotel_13.png', step: 'Menu', lines: [['We offer American classics. There’s a menu next to your television and I have also sent the menu to the phone linked to your account.'], ['Would you like to order now?']], picture: 'a stacked cheeseburger' },
  { file: 'Alexa_Hotel_14.png', step: 'Order', lines: [['I have an order of 1 cheeseburger with 1 side of french fries for room 300.'], ['Would you like anything else?']], picture: 'cola poured over ice' },
  { file: 'Alexa_Hotel_15.png', step: 'Drink', lines: [['I have an order of 1 cheeseburger with 1 side of french fries for room 300.'], ['Would you like something to drink?']], picture: 'cola poured over ice' },
  { file: 'Alexa_Hotel_16.png', step: 'Dessert', lines: [['I have an order of 1 cheeseburger with 1 side of french fries and 1 regular coke without ice for room 300.'], ['Would you like some dessert?']], picture: 'a cake topped with berries' },
  { file: 'Alexa_Hotel_17.png', step: 'Confirmation', lines: [['Your room service order to room number 300 is confirmed for 3 p.m. today.'], [{ text: 'Bon appétit!', lang: 'fr', italic: true }], ['May I help you with anything else?']], picture: 'a smiling receptionist at the hotel reception desk' },
  { file: 'Alexa_Hotel_18.png', step: 'Sign-off', lines: [['Alright, John. Enjoy your stay.'], [{ text: '¡Viva Las Vegas!', lang: 'es', italic: true }]], picture: 'a smiling receptionist at the hotel reception desk' },
];
const fulls = await Promise.all(screens.map(async (s) => (await getImage({ src: img('the-burger-queen', s.file), format: 'webp' })).src));
---
<Base title={project.data.title} description={project.data.summary} current="work">
  <article class="wrap">
    <CaseHeader project={project} />
    <CaseSections>

    <Section id="context" title="Context">
      <div class="col-text prose">
        <p>
          A multimodal assistant, voice plus screen, for Alexa devices in the rooms of a Las Vegas hotel. Guests could hear about the
          hotel’s restaurant, The Burger Queen, and order room service.
        </p>
        <p>
          The brief: a concierge with the feel of a luxury hotel, a consistent brand voice, a way to present the hotel’s other venues,
          and more revenue for the hotel.
        </p>
      </div>
    </Section>

    <Section id="personas" title="Personas">
      <div class="col-wide two-up">
        <Persona name="John" age={24} status="Single" occupation="Tourist (marketer)" location="London, England" quote="I want the American experience in Las Vegas." />
        <Persona name="Miguel" age={45} status="Married" occupation="High roller" location="Las Vegas, Nevada" />
      </div>
    </Section>

    <Section id="conversation" title="The conversation" kicker="Conversation design">
      <div class="col-text prose">
        <p>
          Nine screens from the prototype, in order, from the welcome to the sign-off. Each shows what the assistant says on screen;
          the guest’s spoken replies aren’t part of the screens.
        </p>
      </div>
      <ol class="col-wide screens">
        {screens.map((s, i) => (
          <li class="screen">
            <a class="screen__image zoom" href={fulls[i]} data-alt={`Prototype screen ${i + 1}, ${s.step.toLowerCase()}`} data-caption={`${String(i + 1).padStart(2, '0')}, ${s.step}`}>
              <Picture
                src={img('the-burger-queen', s.file)}
                alt={`Prototype screen ${i + 1}, ${s.step.toLowerCase()}: on-screen text over ${s.picture}. Text transcribed alongside.`}
                formats={['avif', 'webp']}
                widths={[img('the-burger-queen', s.file).width]}
                sizes="(min-width: 900px) 40vw, 100vw"
                loading="lazy"
              />
              <span class="visually-hidden">(opens full size)</span>
            </a>
            <div class="screen__transcript">
              <p class="meta">{String(i + 1).padStart(2, '0')} · {s.step}</p>
              {s.lines.map((para) => (
                <p class="screen__line">
                  {para.map((x) => (typeof x === 'string' ? x : <em lang={x.lang}>{x.text}</em>))}
                </p>
              ))}
            </div>
          </li>
        ))}
      </ol>
      <MarginNote label="Images">The prototype uses stock photos for the food and the reception desk.</MarginNote>
    </Section>

    <Section id="changes" title="What changed">
      <div class="col-text prose">
        <p>
          Reviewing the app, we found three problems: it had no greeting, it didn’t show enough of the food on offer, and its branding
          wasn’t consistent with the hotel. Over iterations we:
        </p>
        <ul>
          <li><strong>Added a personalized greeting.</strong> In these screens, for example, the assistant addresses the guest by name at the end (screen 9).</li>
          <li><strong>Expanded the menu to drinks and desserts</strong>; in these screens they’re offered as the order builds (screens 6 and 7).</li>
          <li><strong>Set foreign terms in italics</strong>, like <em lang="fr">Bon appétit</em> and <em lang="es">¡Viva Las Vegas!</em> (screens 8 and 9).</li>
          <li><strong>Made the branding consistent</strong> with the hotel’s identity.</li>
        </ul>
      </div>
    </Section>
    </CaseSections>
  </article>
  <Pager id={project.id} />
</Base>

<style>
  .screens { list-style: none; margin: var(--space-3) 0 0; padding: 0; }
  .screen {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3) var(--gutter);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--rule);
    align-items: center;
  }
  @media (min-width: 760px) { .screen { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); } }
  .screen__image :global(img) { width: 100%; height: auto; border-radius: 6px; }
  .screen__transcript .meta { margin-bottom: var(--space-2); }
  .screen__line { font-size: var(--step-1); line-height: 1.35; margin-bottom: 0.5em; }
</style>
