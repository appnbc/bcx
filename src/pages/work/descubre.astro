---
import { withBase } from '../../data/url';
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import CaseSections from '../../components/CaseSections.astro';
import Section from '../../components/Section.astro';
import MarginNote from '../../components/MarginNote.astro';
import EditView from '../../components/EditView.astro';
import EnFace from '../../components/EnFace.astro';
import Figure from '../../components/Figure.astro';
import Gallery from '../../components/Gallery.astro';
import Persona from '../../components/Persona.astro';
import Pager from '../../components/Pager.astro';
import { img } from '../../data/images';

const project = (await getEntry('projects', 'descubre'))!;
const vhl = (f: string) => img('descubre', f);

const guidelines = [
  { g: 'Define in context. If a verb is conjugated, conjugate the translation.', es: 'Ella presta atención. (She’s paying attention.)', use: 'pays attention', avoid: 'to pay attention, to give attention', avoidLang: 'en' },
  { g: 'Give an accurate translation, not a literal one that doesn’t correspond.', es: '¡Hay una montaña rusa ahí! (There’s a roller coaster there!)', use: 'roller coaster', avoid: 'Russian mountain', avoidLang: 'en' },
  { g: 'Give an accurate translation, not a confusing false cognate.', es: '¿Quieres ir a la librería? (Do you want to go to the bookstore?)', use: 'bookstore', avoid: 'library', avoidLang: 'en' },
  { g: 'Avoid broad generalizations, especially about people.', use: 'A los gatos les gusta tomar leche. (Cats like to drink milk.)', avoid: 'A los abuelos les gusta tomar té. (Grandparents like to drink tea.)', useLang: 'es', avoidLang: 'es' },
  { g: 'Choose a name that is common in the target region.', use: 'Carlos es de Paraguay.', avoid: 'Charles es de Paraguay.', useLang: 'es', avoidLang: 'es' },
];

const chats = [
  { type: 'Partner', es: '¿Dónde le gusta ver películas a tu pareja? (Ej. ¿Prefieres ver películas en cine o en televisión?)', en: 'Where does your partner like to watch movies? (E.g. Do you prefer to watch movies in the theater or on TV?)' },
  { type: 'Partner', es: '¿A tu pareja le gusta volver a ver películas? (Ej. ¿Repites las películas que te gustan mucho?)', en: 'Does your partner like to watch movies again? (E.g. Do you rewatch movies you really like?)' },
  { type: 'Virtual', es: '¿Qué cines en tu comunidad muestran buenas películas?', en: 'Which movie theaters in your community show good movies?' },
  { type: 'Virtual', es: 'Si una película no te gusta, ¿duermes en el cine?', en: 'If you don’t like a movie, do you fall asleep in the theater?' },
];

const screens = [
  ['VHL_3.png', 'Listening practice: La familia. Students click each person in the family tree to hear how they’re related to José Miguel. Magenta boxes mark the breadcrumb, title and instructions, due date and next-activity button.', 'Listening practice with audio for each family member.'],
  ['VHL_4.png', '"Emparejar" matching activity: instruction line, links to flashcards and vocabulary, and attempts remaining, each boxed in magenta.', 'Matching activity: instructions, references, attempts.'],
  ['VHL_5.png', 'Graded answers with green checks and a red cross, and the score "18 of 20 pts. (90.0%)" beside accept and re-try buttons.', 'Graded answers with accept or re-try.'],
  ['VHL_6.png', 'A browser dialog warns that accepting a 90% grade gives up the remaining unlimited attempts.', 'Confirmation before giving up attempts.'],
  ['VHL_7.png', 'A green "Results finalized" banner above the activity, with practice and next-activity buttons.', 'Finalized results.'],
  ['VHL_8.png', 'Teacher view: the Add content menu opens New activity with Composition, Partner Chat, Student Recording and Video.', 'Teachers can assign a partner chat.'],
  ['VHL_9.png', 'Activity authoring form: activity title, direction line, reference materials and an optional question prompt.', 'Authoring a custom activity.'],
  ['VHL_12.png', 'A reading by María Úrsula Echevarría with an audio button and a highlighted passage about fútbol.', 'Readings with native-speaker audio.'],
  ['VHL_13.png', 'Interactive map of the Galápagos, Colombia and Quito, with tabs for Mapa, Cifras, ¡Increíble pero cierto! and Notas culturales.', 'Interactive culture map.'],
].map(([f, alt, caption]) => ({ src: vhl(f), alt, caption }));
---
<Base title={project.data.title} description={project.data.summary} current="work">
  <article class="wrap">
    <CaseHeader project={project} />
    <CaseSections>

    <Section id="context" title="Context">
      <div class="col-text prose">
        <p>
          World languages, Spanish especially, are popular courses in schools in the U.S. and Canada, and language teaching has been
          moving toward digital material.
        </p>
        <p>
          The goal for this edition: make more of the product’s technology alongside the editorial updates, turn the physical
          textbooks into digital experiences, and bring language learning up to par with other subjects.
        </p>
      </div>
      <MarginNote label="Availability">Sold mostly through schools. A print component was released alongside the digital product. Newer editions aren’t shown here.</MarginNote>
    </Section>

    <Section id="team" title="Team">
      <div class="col-text prose">
        <p>
          I was the editor and UX liaison. Hillary was the program manager and George led
          software engineering.
        </p>
      </div>
      <MarginNote label="Title">My job title was Developmental Editor, World Languages.</MarginNote>
    </Section>

    <Section id="persona" title="Persona">
      <div class="col-text">
        <Persona
          name="Mikey"
          age={14}
          occupation="High school student"
          location="New York City, New York"
          quote="I don’t really enjoy these repetitive exercises. I want to learn the real Spanish people speak outside!"
          bio="Just started high school and knows his grades now matter for the university he wants. Some people don’t think a foreign language is important; he does."
          needs="To learn Spanish, both to talk to more people and to keep his GPA high."
          pains="Mundane tasks like word-for-word translation. Limited class time that isn’t spent talking. Homework that never asks for his own opinions and interests."
        />
      </div>
    </Section>

    <Section id="guidelines" title="Editorial guidelines" kicker="Content strategy">
      <div class="col-text prose">
        <p>
          I helped write the editorial guidelines with colleagues who were subject matter experts in other languages. I focused on
          Spanish; others covered French, German and Italian. Together we set rules for a uniform style across every product, with
          English as the base.
        </p>
        <ul>
          <li><strong>Voice.</strong> Straightforward: somewhere between an encyclopedia entry and a weekly news magazine.</li>
          <li><strong>Spelling.</strong> American spelling for English, with the Chicago Manual of Style for disputes. For Spanish I chose the globally agreed standard, the Real Academia Española.</li>
          <li><strong>Type style.</strong> Bold and italic depend on the interface, print or digital, and on how each affects the reader, for example in translations.</li>
        </ul>
      </div>
      <EnFace
        caption="Sample guidelines. The last column shows what each rule rules out."
        columns={[
          { key: 'g', label: 'Guideline' },
          { key: 'es', label: 'Example', lang: 'es' },
          { key: 'use', label: 'Use', lang: 'en' },
          { key: 'avoid', label: 'Avoid', strike: true },
        ]}
        rows={guidelines}
      />
      <div class="col-wide two-up docs">
        <Figure src={vhl('VHL_1.png')} alt='Document titled "Global Content Guidelines": sections "Use what students know" and "Cognates", explaining when words need a gloss, with French examples such as semestre, université and étudiant.' caption="Global content guidelines, shared across languages." size="wide" />
        <Figure src={vhl('VHL_2.png')} alt='Document titled "Standard formatting guidelines for transforming textbook readings into html readings": left-justified text, no line numbers, and a fixed format for glosses at the bottom of the page.' caption="Rules for turning printed readings into HTML." size="wide" />
      </div>
    </Section>

    <Section id="inclusion" title="Diversity and inclusion">
      <div class="col-text prose">
        <p>
          I worked to make the product more inclusive. I researched and attended photo shoots for images that reflect diversity in
          gender, race and disability.
        </p>
        <p>
          In the text itself, I aimed for a 50/50 split of masculine and feminine pronouns in each lesson, balancing{' '}
          <span lang="es"><em>él/ella</em>, <em>nosotros/nosotras</em>, <em>vosotros/vosotras</em></span>{' '}and{' '}
          <span lang="es"><em>ellos/ellas</em></span> where appropriate, so students hear the pronouns Spanish speakers actually use.
        </p>
      </div>
      <Figure src={vhl('VHL_15.png')} alt='Descubre lesson opener "Las relaciones personales": a list of the lesson’s sections beside a photo of two young people, one using a wheelchair.' caption="A Descubre lesson opener." size="margin" />
    </Section>

    <Section id="digital" title="Digital integration" kicker="UX">
      <div class="col-text prose">
        <p>
          Moving from print to digital took real effort. The first step was getting the material into a digital format: the e-book
          plays a native speaker reading the text, including the vocabulary sections. Other changes made content more interactive,
          with subtitled videos and tables that are more intuitive on screen. I also reworked activities so students use their online
          research skills to explore the language and culture.
        </p>
        <p>
          The most important change was in the instructions. While adapting the XML from the printed workbooks, I found instructions
          students had to follow literally. An exercise that told students to circle a word in a workbook had to say select online,
          because that’s what you do in a graphical interface.
        </p>
      </div>
      <EditView parts={[{ t: '“' }, { del: 'circle' }, { ins: 'select' }, { t: ' the word”' }]} caption="Workbook instruction → online instruction" />
      <Gallery id="descubre-screens" label="Descubre digital activities" items={screens} />
      <MarginNote label="Screenshots">The magenta boxes mark interface details in these review screenshots.</MarginNote>
    </Section>

    <Section id="conversations" title="Conversations" kicker="Conversation design">
      <div class="col-text prose">
        <p>
          This product puts speaking first, so I wrote conversations (chats) relevant to the lessons. Topics range from a student’s family
          life and pets to their philosophical views and the historical events that shaped them. Each chat uses the lesson’s vocabulary
          and grammar, and sometimes its cultural notes.
        </p>
        <p>There are two kinds of chat:</p>
        <ul>
          <li><strong>Partner chat</strong>, with a classmate. Students feel comfortable with someone at their level who has studied the same lesson.</li>
          <li><strong>Virtual chat</strong>, with a computer classmate that speaks with a native voice. Less personal, but it helps students build confidence on their own.</li>
        </ul>
      </div>
      <EnFace
        caption="Chat prompts from a lesson about movies"
        columns={[
          { key: 'type', label: 'Chat' },
          { key: 'es', label: 'Prompt', lang: 'es' },
          { key: 'en', label: 'Translation', lang: 'en', muted: true },
        ]}
        rows={chats}
      />
      <div class="col-wide two-up">
        <Figure src={vhl('VHL_10.png')} alt='"Entrevista" partner chat: a partner list beside a live video of a student.' caption="Partner chat." size="wide" />
        <Figure src={vhl('VHL_11.png')} alt='Virtual chat "Answer Juan Pablo’s questions": a video with a Start button and a note that recording begins automatically.' caption="Virtual chat." size="wide" />
      </div>
    </Section>

    <Section id="retrospective" title="Retrospective">
      <div class="col-text prose">
        <p>
          These decisions, from the style guide to the digital features, were carried into other books the following year, including
          the German collection, <a href={withBase("/work/mosaik/")}>Mosaik</a>. I enjoyed helping teach about my culture, in North America and
          beyond.
        </p>
        <p>
          Textbook publishing is slow, and digital changes come after the print edition. But digital interactions show how people
          actually use the material. I wish I’d had more visibility into that data, so the product could keep improving.
        </p>
      </div>
      <Figure src={vhl('VHL_SpanishCovers.png')} alt="Covers of Descubre 1A, 1B, 1, 2 and 3, each with colorful cultural imagery." caption="The Descubre series." size="wide" frame={false} />
    </Section>
    </CaseSections>
  </article>
  <Pager id={project.id} />
</Base>

<style>
  .docs { margin-top: var(--space-4); }
  .docs :global(.figure) { margin: 0; }
</style>
