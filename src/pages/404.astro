---
import { withBase } from '../data/url';
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn’t exist. Find Brian Contreras’s work from the homepage or the Index.">
  <div class="wrap grid not-found">
    <p class="col-text not-found__code">404</p>
    <h1 class="col-wide">This page doesn’t exist.</h1>
    <p class="col-text not-found__text">
      The link may be old or mistyped. Everything is still here:
    </p>
    <ul class="col-text not-found__links">
      <li><a class="more" href={withBase("/")}>Go to the homepage</a></li>
      <li><a class="more" href={withBase("/archive/")}>Browse all projects in the Index</a></li>
    </ul>
  </div>
</Base>

<style>
  .not-found { padding-block: var(--space-7); row-gap: var(--space-3); }
  .not-found__code { font-family: var(--sans); font-weight: 600; color: var(--ink-muted); margin: 0; }
  .not-found h1 { font-size: clamp(2.4rem, 1.4rem + 4vw, 5rem); letter-spacing: -0.03em; }
  .not-found__text { font-size: var(--step-1); color: var(--ink-muted); }
  .not-found__links { list-style: none; padding: 0; display: grid; gap: var(--space-3); }
  .more {
    font-family: var(--sans);
    font-weight: 600;
    text-decoration: none;
    background: linear-gradient(var(--highlight), var(--highlight)) no-repeat 0 100% / 100% 0.3em;
    padding-inline: 0.1em;
    transition: background-size 150ms ease;
  }
  .more:hover { background-size: 100% 100%; color: var(--on-highlight); }
</style>
