---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/public-sans/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import { site, hasContact } from '../config';
import { href, stripLocale, type Locale } from '../i18n/locales';
import { ui } from '../i18n/ui';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  current?: 'work' | 'archive' | 'about';
  /** Keep this page out of search results. Non-English pages also stay out until languages are public. */
  noindex?: boolean;
  /** Set false on pages with no Spanish/Italian version (the 404): no switcher, no alternates. */
  translations?: boolean;
  /** Header starts transparent over the page (the homepage hero) and turns solid once scrolled. */
  overlayHeader?: boolean;
}

const { title, description, lang = 'en', current, noindex = false, translations = true, overlayHeader = false } = Astro.props;
const offerLanguages = site.languagesPublic && translations;
const t = ui[lang];
const fullTitle = title === site.name ? `${site.name} — ${t.role}` : `${title} — ${site.name}`;
const hidden = noindex || (lang !== 'en' && !site.languagesPublic);
// Search engines want absolute URLs in hreflang links; locally there is no site URL, so keep paths.
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const path = stripLocale(Astro.url.pathname);
const nav = [
  { path: '/#work', label: t.nav.work, key: 'work' },
  { path: '/archive/', label: t.nav.index, key: 'archive' },
  { path: '/about/', label: t.nav.about, key: 'about' },
];
const { email, linkedin, other = [] } = site.contact;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="color-scheme" content="dark" />
    {hidden && <meta name="robots" content="noindex" />}
    {offerLanguages && (
      <>
        <link rel="alternate" hreflang="en" href={abs(href('en', path))} />
        <link rel="alternate" hreflang="es" href={abs(href('es', path))} />
        <link rel="alternate" hreflang="it" href={abs(href('it', path))} />
        <link rel="alternate" hreflang="x-default" href={abs(href('en', path))} />
      </>
    )}
    <link rel="icon" href={href('en', '/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        // Dark unless the visitor picked light with the header switch.
        try {
          const theme = localStorage.getItem('theme');
          if (theme === 'light' || theme === 'dark') root.dataset.theme = theme;
        } catch {}
        // Arriving from the language switcher: paint one frame in the previous language's
        // palette, then let the accent colours ease into this one (transition in tokens.css).
        try {
          const from = sessionStorage.getItem('lang-from');
          sessionStorage.removeItem('lang-from');
          if (!from || from === root.lang || !/^(en|es|it)$/.test(from) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          root.dataset.fromLang = from;
          const release = () => requestAnimationFrame(() => requestAnimationFrame(() => delete root.dataset.fromLang));
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', release, { once: true });
          else release();
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipLink}</a>
    <header class:list={['site-header', { 'site-header--overlay': overlayHeader }]}>
      <div class="wrap">
        <a class="site-name" href={href(lang, '/')}>{site.name} <span>{t.role}</span></a>
        <div class="site-bar">
          <nav class="site-nav" aria-label={t.nav.label}>
            <ul>
              {nav.map((item) => (
                <li>
                  <a href={href(lang, item.path)} aria-current={item.key === current ? 'page' : undefined}>{item.label}</a>
                </li>
              ))}
              <li><a href="#contact">{t.nav.contact}</a></li>
            </ul>
          </nav>
          <div class="site-tools">
            {offerLanguages && <LanguageSwitcher lang={lang} path={path} />}
            <ThemeSwitch lang={lang} />
          </div>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer" id="contact">
      <div class="wrap contact">
        <h2 class="contact__title">{t.contact.title}</h2>
        {hasContact ? (
          <>
            <p class="contact__lead">{t.contact.question} <mark>{t.contact.ask}</mark></p>
            {email && (
              <div class="contact__row">
                <p class="contact__bubble"><a class="contact-big" href={`mailto:${email}`}>{email}</a></p>
                <p class="contact__copy">
                  <button type="button" data-copy={email} data-copied={t.contact.copied} data-failed={t.contact.copyFailed}>{t.contact.copy}</button>
                  <span class="contact__status" data-copy-status role="status"></span>
                </p>
              </div>
            )}
            {(linkedin || other.length > 0) && (
              <ul class="contact-list label">
                {linkedin && <li><a href={linkedin}>LinkedIn</a></li>}
                {other.map((o) => <li><a href={o.href}>{o.label}</a></li>)}
              </ul>
            )}
          </>
        ) : (
          <p class="label">{t.contact.soon}</p>
        )}
      </div>
    </footer>

    <dialog id="lightbox" class="lightbox" aria-label={t.lightbox.label}>
      <div class="lightbox__bar"><button type="button" class="label" data-close>{t.lightbox.close}</button></div>
      <figure class="lightbox__figure"><figcaption></figcaption></figure>
    </dialog>
    <script>
      import { initLightbox } from '../scripts/lightbox';
      import { initHeader } from '../scripts/header';
      initLightbox();
      initHeader();

      // Copy email: many visitors have no mail app set up for mailto links.
      document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((btn) => {
        const status = btn.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy!);
            if (status) status.textContent = btn.dataset.copied ?? '';
          } catch {
            if (status) status.textContent = btn.dataset.failed ?? '';
          }
          window.setTimeout(() => status && (status.textContent = ''), 4000);
        });
      });
    </script>
  </body>
</html>
